# Supabase (get from Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only secret key + webhook signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL of this app, used to build absolute links (booking confirmations, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
